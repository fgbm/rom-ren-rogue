# ---------------------------------------------------------------- заказчики

client velt "Вельт"
  label Ликвидатор. Достать, вернуть на баланс. 3000 на счету.
  credit 3000
  attention 1
  items ice_old
  unlocked
client marsh "Марш"
  label Тьюринг. Найти, указать. Бумага бюро, 800 на счету.
  credit 800
  attention 0
  items ice_old marsh_paper
client zero "Брат Ноль"
  label Культ. Спрятать от всех. Даб Дзиона, 600 на счету.
  credit 600
  attention 1
  items ice_old dub
client moriyama "Морияма"
  label Клиника. Пройти дорогу, ничего не неся. Патч, 900 на счету.
  credit 900
  attention 1
  items ice_old patch
client hanna "Ханна"
  label Оригинал. Принести ей. 2000 на счету, Тьюринг уже смотрит.
  credit 2000
  attention 2
  items ice_old
client sato "Сато"
  label Оно-Сэндай. Урегулировать. 4000 на счету, бюро оплачено.
  credit 4000
  attention 0
  items ice_old
client koenig "Кёниг"
  label Скупка. Собрать лот. Осколок в деке, 1000 на счету.
  credit 1000
  attention 1
  items ice_old shard
client silence "—"
  label Никто не платил. Ничего не нести. Пустой счёт, пустая дека.
  credit 0
  attention 1
  items
