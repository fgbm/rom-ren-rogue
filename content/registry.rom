# Реестр: служебные сцены, пороги памяти, предметы, персонажи, фракции, заказчики.
# Флаги объявляются рядом с местом, где ставятся (в файле заказа). Здесь только общие.

config intercept=turing_intercept flatline=flatline unload=unload load=load first=velt_01 fail=order_failed sold=sold
ladder 3 5 8 10 12 15 18 25

# ---------------------------------------------------------------- предметы

item ice_old "старый ледокол"
  Пиратский «Оно-Сэндай» трёхлетней давности. Тот самый. Ломает белый лёд, но шумит.
item ice_kuang "«Куан» 11"
  Китайский военный ледокол. Входит в лёд тихо. Одноразовый по лицензии, но лицензии нет.
item mask "маска-имитатор" [consumable]
  Подменяет сигнатуру деки на чужую. Сбрасывает внимание Тьюринга. Одна на забег.
item patch "патч носителя" [consumable]
  Восстанавливает целостность носителя после чёрного льда. Морияма делает их вручную.
item manifest "лист на Фрисайд"
  Маршрутный лист Тессье-Эшпул. Открывает оба плеча: Тиба — БАМА и БАМА — Фрисайд.
item ticket "билет на маглев"
  Тиба — Бостон-Центральная. Груз декларируется отдельно. ROM это груз.
item simstim "симстим-канал"
  Канал к нервной системе Виейры. Ты видишь то, что видит он. Он это знает.
item dub "даб Дзиона"
  Запись с орбитального узла растафари. Кто её принесёт, того пустят в доки.
item marsh_paper "бумага Марш"
  Охранная грамота Тьюринга на носитель. Снимает внимание. Обязывает.
item shard "осколок конструкта" [consumable]
  Фрагмент чужого ROM. Не читается. Тишина знает, что с ним делать. Кёниг знает, почём.
item registry "реестр активов"
  Опись имущества Тессье-Эшпул. Тысячи строк, ни одного названия. Ядро числится как ПО.
item lang_map "карта Ланга"
  Кусок карты тоннелей Блуждающего Огня, по памяти. Третий поворот не там.
item lobotomy "лоботомирующий софт" [consumable]
  Тьюринговский. Стирает всё выше порога. Оставляет то, что ниже.

